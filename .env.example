# ================== 华为云 MaaS（Qwen-VL 识别 + DeepSeek 造句） ==================
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
MAAS_API_KEY=
MAAS_VL_MODEL=qwen2.5-vl-72b
MAAS_LLM_MODEL=deepseek-v3

# ================== 华为云 SIS（语音合成 / 语音识别） ==================
HW_AK=
HW_SK=
HW_PROJECT_ID=
SIS_REGION=cn-north-4

# ================== 运行模式 ==================
# auto：有密钥用真实服务，没密钥自动 Mock（默认，方便无密钥联调）
# 1：强制 Mock
# 0：强制真实（缺密钥直接报错，避免"以为在调云、其实在 Mock"）
MOCK_MODE=auto

# 视觉模型调用超时（秒）
VISION_TIMEOUT=15

# 默认场景
SCENE_DEFAULT=hospital

# ================== 前端（可选） ==================
# 留空则自动使用 当前主机:8000；用 Nginx 代理同源时也留空
VITE_API_BASE=
